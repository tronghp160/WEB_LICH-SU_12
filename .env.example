# Sao chép file này thành `.env.local` rồi điền giá trị thật (lấy trong Supabase Dashboard → Project Settings → API).
# KHÔNG commit `.env.local`.

# URL của project Supabase (công khai, trình duyệt cũng dùng).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Khóa publishable (công khai, đi kèm RLS nên an toàn khi lộ ra trình duyệt).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Khóa bí mật — CHỈ dùng phía server (trang Quản trị → Nhân sự: tạo/khóa tài khoản).
# Tuyệt đối không đặt tiền tố NEXT_PUBLIC_ cho biến này.
SUPABASE_SECRET_KEY=sb_secret_...

# (Tùy chọn) Địa chỉ web khi đã có tên miền — dùng cho ảnh chia sẻ (Open Graph), sitemap.xml, robots.txt.
# Bỏ trống trên Vercel sẽ tự dùng tên miền production của Vercel.
NEXT_PUBLIC_SITE_URL=https://lichsu12.example.vn

# (Tùy chọn) Chuỗi kết nối Postgres để chạy migration/seed bằng Supabase CLI.
# Supabase Dashboard → Connect → Session pooler. Không in giá trị này ra log.
DATABASE_URL=postgresql://postgres.<project-ref>:<mật-khẩu>@<host>:5432/postgres

# Không đặt ở đây: TEST_PW (mật khẩu chung các tài khoản thử) — truyền khi chạy lệnh, ví dụ
#   TEST_PW='...' npm run test:e2e

# ===== Thanh toán (docs/ke-hoach-thanh-toan.md, mục 16.1) — CHỈ phía server =====
# Cổng đang dùng: mock (giả lập, để phát triển/demo) | payos (chuyển khoản VietQR thật) | vnpay (chưa cài đặt).
PAYMENT_PROVIDER=mock
# test: hiện nhãn "Môi trường thử nghiệm"; cổng giả lập CHỈ chạy khi test. Đặt live khi thu tiền thật.
PAYMENT_ENV=test
# Chuỗi ngẫu nhiên ≥ 32 ký tự, ví dụ tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Bí mật ký webhook của cổng giả lập.
MOCK_PAYMENT_SECRET=
# Muối để băm IP người mua và mã thiết bị (không lưu giá trị thô).
PAYMENT_HASH_SALT=
# Chỉ đặt 1 khi TỰ HOST sau reverse proxy đáng tin (nginx…): khi đó mới đọc IP từ x-real-ip / x-forwarded-for.
# Trên Vercel để trống (Vercel tự đặt header IP). Không có IP đáng tin thì giới hạn số lần thử dùng cookie định danh.
TRUST_PROXY=

# payOS — my.payos.vn → Kênh thanh toán → Thông tin tích hợp. CHỈ phía server, không đặt tiền tố NEXT_PUBLIC_.
# Lưu ý: với payOS, kể cả PAYMENT_ENV=test, tiền chuyển khoản là TIỀN THẬT vào tài khoản ngân hàng của kênh.
# Sau khi deploy, đăng ký URL webhook:
#   node --env-file=.env.local scripts/payos-confirm-webhook.mjs https://<ten-mien>/api/thanh-toan/webhook/payos
# NEXT_PUBLIC_SITE_URL phải là địa chỉ web thật (payOS chuyển người mua về <địa chỉ>/thanh-toan/ket-qua).
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
